<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shisui.UI.ViewModels"
        xmlns:views="using:Shisui.UI.Views"
        x:Class="Shisui.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Shisui"
        Icon="avares://Shisui.UI/icon/app.ico"
        Width="880" Height="620" MinWidth="760" MinHeight="500"
        Background="Transparent"
        ExtendClientAreaTitleBarHeightHint="32"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="AcrylicBlur"
        WindowStartupLocation="CenterScreen">

  <Panel>
    <!--  ウィンドウ背景：アクリルブラー (Lhamiel と同じ Tahoe 風ガラス質感)  -->
    <ExperimentalAcrylicBorder IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial
            BackgroundSource="Digger"
            TintColor="{DynamicResource Color.Window}" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <!--  実行ログ行は GridSplitter でドラッグ調節可能 (初期 90px)。タブ側 (Row 0) は MinHeight で潰れ防止。  -->
    <Grid Margin="16,36,16,16" IsEnabled="{Binding !IsProcessing}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="220" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="90" MinHeight="60" />
      </Grid.RowDefinitions>
      <!--  ═══ サイドバー + コンテンツ ═══  -->
      <TabControl Grid.Row="0" Classes="sidebar" SelectedIndex="0" IsEnabled="{Binding CanChangeNetwork}">
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" VerticalAlignment="Center"
                     Source="avares://Shisui.UI/Resources/FluentSystemIcons/design_ideas.png"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock Text="自動最適化" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:AutoOptimizationView DataContext="{Binding AutoOptimization}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" VerticalAlignment="Center"
                     Source="avares://Shisui.UI/Resources/FluentSystemIcons/globe.png"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock Text="DNS 設定" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:DnsSettingsView DataContext="{Binding DnsSettings}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" VerticalAlignment="Center"
                     Source="avares://Shisui.UI/Resources/FluentSystemIcons/data_line.png"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock Text="ネットワーク診断" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:NetworkDiagnosticsView DataContext="{Binding NetworkDiagnostics}" />
        </TabItem>
        <TabItem IsVisible="{Binding IsWindows}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" VerticalAlignment="Center"
                     Source="avares://Shisui.UI/Resources/FluentSystemIcons/gauge.png"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock Text="BBR2 / TCP 調整" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:TcpTuningView DataContext="{Binding TcpTuning}" />
        </TabItem>
        <TabItem IsVisible="{Binding IsWindows}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" VerticalAlignment="Center"
                     Source="avares://Shisui.UI/Resources/FluentSystemIcons/toolbox.png"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock Text="メンテナンス" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:MaintenanceView DataContext="{Binding Maintenance}" />
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Image Width="20" Height="20" VerticalAlignment="Center"
                     Source="avares://Shisui.UI/Resources/FluentSystemIcons/question_circle.png"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock Text="バージョン" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </TabItem.Header>
          <views:VersionView DataContext="{Binding Version}" />
        </TabItem>
      </TabControl>

      <!--  ドラッグで実行ログの高さを調節するスプリッター (ガラス背景に馴染む細いグリップ)  -->
      <GridSplitter Grid.Row="1" Height="12" Margin="0,2,0,-2"
                    Background="Transparent" ResizeDirection="Rows"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <GridSplitter.Template>
          <ControlTemplate>
            <Border Background="Transparent" Height="12">
              <Border Width="48" Height="4" CornerRadius="2" VerticalAlignment="Center"
                      Background="{DynamicResource Brush.Border}" />
            </Border>
          </ControlTemplate>
        </GridSplitter.Template>
      </GridSplitter>

      <!--  ═══ 実行ログ (Lhamiel のガラスカードと同じ質感)  ═══  -->
      <Border
          Grid.Row="2"
          Padding="12"
          Background="{DynamicResource Brush.Container}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1"
          CornerRadius="14">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="実行ログ" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.FG2}" Margin="0,0,0,8" />
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding LogEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CommandLogEntry">
                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                    <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" FontFamily="Consolas,Menlo,monospace"
                               FontSize="12" Foreground="{DynamicResource Brush.FG2}" />
                    <TextBlock Text="OK" Foreground="#34C759" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                               FontWeight="SemiBold" IsVisible="{Binding Success}" />
                    <TextBlock Text="NG" Foreground="#FF3B30" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                               FontWeight="SemiBold" IsVisible="{Binding !Success}" />
                    <TextBlock Text="{Binding CommandLine}" FontFamily="Consolas,Menlo,monospace" FontSize="12"
                               Foreground="{DynamicResource Brush.FG1}" TextWrapping="NoWrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- 通常の入力を遮り、処理の進行と Ping の中止操作を表示する。 -->
    <Border IsVisible="{Binding IsProcessing}" Background="{DynamicResource Brush.ContainerAlt}">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center"
              MaxWidth="440" Margin="28" Padding="28,24"
              Background="{DynamicResource Brush.Window}"
              BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="18">
        <StackPanel Spacing="16">
          <TextBlock Text="処理中" FontSize="20" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Foreground="{DynamicResource Brush.FG1}" />
          <ProgressBar IsIndeterminate="True" Height="4" Width="240"
                       Foreground="{DynamicResource Brush.Accent}" />
          <TextBlock Text="{Binding ProcessingText}" TextWrapping="Wrap"
                     TextAlignment="Center" Foreground="{DynamicResource Brush.FG2}" />
          <Button Content="測定を中止" HorizontalAlignment="Center"
                  IsVisible="{Binding NetworkDiagnostics.PingCommand.IsRunning}"
                  IsEnabled="{Binding NetworkDiagnostics.PingCommand.CanBeCanceled}"
                  Command="{Binding NetworkDiagnostics.PingCancelCommand}" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
